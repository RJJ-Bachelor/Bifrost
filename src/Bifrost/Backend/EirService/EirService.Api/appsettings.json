{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Npgsql.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Messaging": {
    "Delivery": {
      "MaximumAttempts": 8
    },
    "ModuleRoutes": {
      "eir.session.updated": {
        "Transport": "Local"
      },
      "eir.faq.answer-recorded": {
        "Transport": "Local"
      }
    }
  }
}
