<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NBomber" Version="6.7.0" />
    <PackageReference Include="MessagePack" Version="2.5.303" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
    <PackageReference Include="Microsoft.Playwright" Version="1.56.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <ProjectReference Include="../EirService/EirService.Api/EirService.Api.csproj" />
    <ProjectReference Include="../../Orchestration/VarService/VarService.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Configuration/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
