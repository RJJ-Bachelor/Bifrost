<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The AppHost's user secrets, so the Gemini key is only set in one place. -->
    <UserSecretsId>1715c601-05dc-4fce-8fac-e2c710f60750</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MimirService.Application\MimirService.Application.csproj" />
    <ProjectReference Include="..\MimirService.Infrastructure\MimirService.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="generalization-cases.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the harness write its Markdown report next to the dataset instead of into bin. -->
    <AssemblyMetadata Include="EvalsDirectory" Value="$(MSBuildProjectDirectory)" />
  </ItemGroup>

</Project>
