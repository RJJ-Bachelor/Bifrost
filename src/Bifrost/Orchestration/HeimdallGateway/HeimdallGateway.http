@HeimdallGateway_HostAddress = http://localhost:6004
@sessionId = REPLACE_WITH_CREATED_SESSION_ID
@sessionCode = REPLACE_WITH_CREATED_SESSION_CODE

### Start OIDC login (open this request in a browser)
GET {{HeimdallGateway_HostAddress}}/account/login

### Join the selected session. Heimdall issues and reuses the student cookie.
POST {{HeimdallGateway_HostAddress}}/api/students/sessions/join
Content-Type: application/json

{"code":"{{sessionCode}}"}

### Create a help request as the student, including during teacher login.
POST {{HeimdallGateway_HostAddress}}/api/students/sessions/{{sessionId}}/requests
Content-Type: application/json

{
  "message": "Create a help request as a student",
  "helpType": "Physical"
}

### Create a session without login. Expected: 401 Unauthorized.
POST {{HeimdallGateway_HostAddress}}/api/teachers/sessions
Content-Type: application/json

{"title":"Testsession"}

### Create a session after completing OIDC login with the Teacher role.
POST {{HeimdallGateway_HostAddress}}/api/teachers/sessions
Content-Type: application/json

{"title":"Testsession"}

### Logout
GET {{HeimdallGateway_HostAddress}}/account/logout
