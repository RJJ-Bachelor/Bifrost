{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "development-seed": {
        "ClusterId": "eir",
        "Match": {
          "Path": "/api/teachers/development/seed",
          "Methods": [
            "POST"
          ]
        },
        "AuthorizationPolicy": "Teacher",
        "Transforms": [
          {
            "PathSet": "/api/test/seed"
          }
        ]
      },
      "development-generalizations": {
        "ClusterId": "mimir",
        "Match": {
          "Path": "/api/teachers/development/generalizations",
          "Methods": [
            "POST"
          ]
        },
        "AuthorizationPolicy": "Teacher",
        "Transforms": [
          {
            "PathSet": "/api/test/generalizations"
          }
        ]
      }
    },
    "Clusters": {
      "mimir": {
        "Destinations": {
          "mimir-api": {
            "Address": "http://localhost:6002/"
          }
        }
      }
    }
  }
}
