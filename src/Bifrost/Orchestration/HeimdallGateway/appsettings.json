{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Frontend": {
    "Url": "http://localhost:7003",
    "AdditionalUrls": [ "http://localhost:7001", "http://localhost:7000", "http://localhost:7002" ]
  },
  "ReverseProxy": {
    "Routes": {
      "monitoring": {
        "ClusterId": "eir",
        "Match": { "Path": "/api/monitoring/{**catch-all}" },
        "AuthorizationPolicy": "Anonymous"
      },
      "students": {
        "ClusterId": "eir",
        "Match": { "Path": "/api/students/{**catch-all}" },
        "AuthorizationPolicy": "Anonymous"
      },
      "teachers": {
        "ClusterId": "eir",
        "Match": { "Path": "/api/teachers/{**catch-all}" },
        "AuthorizationPolicy": "Teacher"
      }
    },
    "Clusters": {
      "eir": {
        "Destinations": {
          "eir-api": { "Address": "http://localhost:6000/" }
        }
      }
    }
  }
}
