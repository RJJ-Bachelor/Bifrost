#!/usr/bin/env bash

COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2

# Skip for merge commits
if [ "$COMMIT_SOURCE" = "merge" ]; then
    exit 0
fi

# Skip for fixup/squash/amend/reword (autosquash handling)
FIRST_LINE_CHECK=$(grep -v '^#' "$COMMIT_MSG_FILE" | head -n 1)
if echo "$FIRST_LINE_CHECK" | grep -q -E '^(fixup|squash|amend|reword)!'; then
    exit 0
fi

# Get current branch name
BRANCH_NAME=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ -z "$BRANCH_NAME" ]; then
    exit 0
fi

# Find Jira format (e.g. BF-001, JIRA-1234)
JIRA_KEY=$(echo "$BRANCH_NAME" | grep -o -E '[A-Z]{2,10}-[0-9]+' | head -n 1)

if [ -n "$JIRA_KEY" ]; then
    FIRST_LINE=$(grep -v '^#' "$COMMIT_MSG_FILE" | head -n 1)

    # Only prepend if the line does not already start with [$JIRA_KEY]
    if ! echo "$FIRST_LINE" | grep -q -E "^\[$JIRA_KEY\]"; then
        ORIGINAL_MSG=$(cat "$COMMIT_MSG_FILE")
        echo "[$JIRA_KEY] $ORIGINAL_MSG" > "$COMMIT_MSG_FILE"
    fi
fi
